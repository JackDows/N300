{
  "name": "deskhub-desktop",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "tauri": "tauri",
    "app:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/project.ps1 -Action Build -Configuration Release",
    "test:unit": "vitest run",
    "test:desktop": "playwright test",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "review:visual": "node scripts/review-studio.mjs",
    "build:visual": "tsc -b && vite build --config vite.visual.config.ts",
    "preview:visual": "vite preview --config vite.visual.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
