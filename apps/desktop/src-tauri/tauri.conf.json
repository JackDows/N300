{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskHub",
  "version": "0.3.0",
  "identifier": "local.deskhub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskHub",
        "width": 920,
        "height": 620,
        "minWidth": 780,
        "minHeight": 540,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#0c0f13"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {}
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2MDIzMjIyODQ1MUQ5Q0MKUldUTTJWR0VJaklDbHRSQ3FzNGxoak40dTZQWEVUcXlpdE0rRHpVZnI5VkhkNWxjOXNSd2JiU0gK",
      "endpoints": [
        "https://github.com/JackDows/N300/releases/download/deskhub-stable/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
