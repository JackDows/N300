function(deskhub_module target adapter core)
  add_executable(${target} "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/src/runtime.cpp" "${adapter}")
  target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/include")
  target_link_libraries(${target} PRIVATE ${core} nlohmann_json::nlohmann_json)
  target_compile_options(${target} PRIVATE /W4 /utf-8 /EHsc)
  file(READ "${CMAKE_CURRENT_SOURCE_DIR}/module.json" manifest)
  string(JSON module_id GET "${manifest}" id)
  string(JSON module_version GET "${manifest}" version)
  target_compile_definitions(${target} PRIVATE DESKHUB_MODULE_ID="${module_id}" DESKHUB_MODULE_VERSION="${module_version}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/module.json")
  set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_SOURCE_DIR}/artifacts/dist/$<CONFIG>")
  install(TARGETS ${target} RUNTIME DESTINATION .)
endfunction()
