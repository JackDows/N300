{
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true
  },
  "search.exclude": {
    ".venv": true,
    "**/.local": true,
    "**/artifacts": true,
    "**/research/inputs": true,
    "**/research/evidence": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/src-tauri/gen": true
  },
  "rust-analyzer.linkedProjects": [
    "Cargo.toml"
  ]
}
